# Branding
ORG_NAME=BK FIRE

# Cloudinary — upload full layout print (PNG); QR download trỏ tới file này
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bkfire-thermalphotobooth

# QR download fallback (khi chưa upload Cloudinary). {id} = photo id.
# Khi có Cloudinary, phiếu in dùng luôn secure_url Cloudinary.
QR_BASE_URL=https://my-photobooth.app/photo/{id}

# QR "SCAN TO REGISTER" — dán link Google Form khi có
REGISTER_QR_URL=https://www.youtube.com

# Camera: auto (Sony nếu có, không thì MacBook) | gphoto | webcam
CAMERA_BACKEND=auto
WEBCAM_DEVICE_INDEX=0

# Printer: usb | cups | file
PRINTER_BACKEND=cups
PRINTER_VENDOR_ID=0xfe6
PRINTER_PRODUCT_ID=0x811e
PRINTER_CUPS_NAME=Manufacture_Virtual_PRN

# Tách nền chủ thể trước khi dither / in (true|false). Mặc định tắt — giữ nền chụp.
REMOVE_BACKGROUND=false

# Overlay film-strip lên ảnh sau khi chụp (RGBA, mặc định assets/frame_border.png)
# FRAME_BORDER_PATH=assets/frame_border.png

# Web
HOST=0.0.0.0
PORT=8000
