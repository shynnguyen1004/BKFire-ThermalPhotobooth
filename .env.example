# Branding
ORG_NAME=BK FIRE

# Cloudinary — nơi lưu ảnh online (QR download sẽ redirect tới đây)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bk-fire-photobooth

# QR download (góc trái phiếu in) — link ngắn redirect, {id} = photo id.
# Giữ URL ≤ ~50 ký tự để QR 62px trên template còn quét được.
QR_BASE_URL=https://my-photobooth.app/photo/{id}

# QR "SCAN TO REGISTER" (góc phải) — tạm placeholder, đổi khi có link thật
REGISTER_QR_URL=https://www.youtube.com

# Camera: auto (Sony nếu có, không thì MacBook) | gphoto | webcam
CAMERA_BACKEND=auto
WEBCAM_DEVICE_INDEX=0

# Printer: usb | cups | file
PRINTER_BACKEND=cups
PRINTER_VENDOR_ID=0xfe6
PRINTER_PRODUCT_ID=0x811e
PRINTER_CUPS_NAME=Manufacture_Virtual_PRN

# Web
HOST=0.0.0.0
PORT=8000
